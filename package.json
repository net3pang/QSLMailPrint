{
  "name": "qsl-mail",
  "version": "1.1.4",
  "author": "QSL Mail contributors <qsl-mail@users.noreply.github.com>",
  "license": "MIT",
  "description": "Cross-platform envelope printing studio for amateur radio operators",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "go-backend": "go run ./backend",
    "check": "node scripts/check.cjs",
    "build:backend": "node scripts/build-backend.cjs",
    "dist": "npm run build:backend && electron-builder --publish never",
    "dist:dir": "npm run build:backend && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^31.0.0",
    "electron-builder": "^26.0.12",
    "@electron/notarize": "^2.5.0"
  },
  "build": {
    "appId": "org.qslmail.desktop",
    "productName": "QSL Mail",
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/bin",
        "to": "backend",
        "filter": [
          "qsl-mail-backend*"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "afterSign": "scripts/notarize.cjs",
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
